// CRM Chapin - esquema multi-tenant.
// Toda tabla de negocio cuelga de `Empresa` (el tenant) y se filtra por `empresaId`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant, usuarios y suscripcion
// ---------------------------------------------------------------------------

enum Plan {
  GRATIS
  EMPRENDEDOR
  NEGOCIO
}

enum EstadoSuscripcion {
  PRUEBA
  ACTIVA
  VENCIDA
  CANCELADA
}

enum Rol {
  PROPIETARIO
  ADMIN
  // En una clínica es la recepción.
  VENDEDOR
  // Ve su propia agenda y el expediente de los pacientes.
  MEDICO
}

/**
 * Cambia el vocabulario y el menú: una clínica no tiene "embudo" ni "cotizaciones".
 */
enum Giro {
  GENERAL
  CLINICA
}

model Empresa {
  id                        String            @id @default(cuid())
  nombre                    String
  slug                      String            @unique
  nit                       String?
  telefono                  String?
  direccion                 String?
  departamento              String?
  municipio                 String?
  logoUrl                   String?
  // Impuesto sobre ventas: en Guatemala el IVA general es 12%.
  ivaPorcentaje             Decimal           @default(12) @db.Decimal(5, 2)
  moneda                    String            @default("GTQ")
  giro                      Giro              @default(GENERAL)
  // Página pública /reservar/<slug> donde los pacientes agendan solos.
  reservasActivas           Boolean           @default(false)
  // Horas mínimas de anticipación y días hacia adelante que se pueden reservar.
  reservasAnticipacionHoras Int               @default(2)
  reservasDiasMax           Int               @default(30)
  plan                      Plan              @default(GRATIS)
  estadoSuscripcion         EstadoSuscripcion @default(PRUEBA)
  pruebaTermina             DateTime?
  planRenuevaEl             DateTime?
  creadoEl                  DateTime          @default(now())
  actualizadoEl             DateTime          @updatedAt

  usuarios          Usuario[]
  contactos         Contacto[]
  etapas            EtapaEmbudo[]
  oportunidades     Oportunidad[]
  actividades       Actividad[]
  notas             Nota[]
  productos         Producto[]
  movimientos       MovimientoInventario[]
  cotizaciones      Cotizacion[]
  ventas            Venta[]
  pagos             PagoSuscripcion[]
  profesionales     Profesional[]
  citas             Cita[]
  recordatorios     Recordatorio[]
  google            IntegracionGoogle?
  whatsapp          IntegracionWhatsApp?
  bloqueos          BloqueoAgenda[]
  tiposConsulta     TipoConsulta[]
  notasClinicas     NotaClinica[]
  accesosExpediente AccesoExpediente[]
}

model Usuario {
  id            String       @id @default(cuid())
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre        String
  email         String       @unique
  passwordHash  String
  telefono      String?
  rol           Rol          @default(VENDEDOR)
  // Para el rol MEDICO: el profesional de la agenda que es esta persona.
  profesionalId String?      @unique
  profesional   Profesional? @relation(fields: [profesionalId], references: [id], onDelete: SetNull)
  activo        Boolean      @default(true)
  ultimoAcceso  DateTime?
  creadoEl      DateTime     @default(now())

  contactosAsignados Contacto[]             @relation("ContactoResponsable")
  oportunidades      Oportunidad[]
  actividades        Actividad[]
  notas              Nota[]
  movimientos        MovimientoInventario[]
  cotizaciones       Cotizacion[]
  ventas             Venta[]
  tokensRecuperacion TokenRecuperacion[]
  citasCreadas       Cita[]
  notasClinicas      NotaClinica[]
  accesosExpediente  AccesoExpediente[]

  @@index([empresaId])
}

/**
 * Enlace de un solo uso para restablecer la contrasena. Se guarda el hash del
 * token, no el token: si alguien lee la base de datos no puede usarlo.
 */
model TokenRecuperacion {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiraEl  DateTime
  usadoEl   DateTime?
  creadoEl  DateTime  @default(now())

  @@index([usuarioId])
}

model PagoSuscripcion {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  plan       Plan
  monto      Decimal  @db.Decimal(12, 2)
  // Los emprendedores en Guatemala suelen pagar por deposito o transferencia.
  metodo     String
  referencia String?
  cubreDesde DateTime
  cubreHasta DateTime
  confirmado Boolean  @default(false)
  creadoEl   DateTime @default(now())

  @@index([empresaId])
}

// ---------------------------------------------------------------------------
// CRM: contactos, embudo, actividades
// ---------------------------------------------------------------------------

enum OrigenContacto {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  TIKTOK
  REFERIDO
  SITIO_WEB
  LLAMADA
  VISITA
  FERIA
  OTRO
}

model Contacto {
  id                         String         @id @default(cuid())
  empresaId                  String
  empresa                    Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre                     String
  negocio                    String?
  email                      String?
  telefono                   String?
  // Se guarda en formato internacional (502XXXXXXXX) para armar enlaces wa.me.
  whatsapp                   String?
  nit                        String?
  direccion                  String?
  departamento               String?
  municipio                  String?
  origen                     OrigenContacto @default(WHATSAPP)
  etiquetas                  String[]       @default([])
  notas                      String?
  // Datos de paciente (clínicas). Todos opcionales.
  fechaNacimiento            DateTime?
  dpi                        String?
  sexo                       String?
  tipoSangre                 String?
  seguroMedico               String?
  alergias                   String?
  antecedentes               String?
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?
  // Cuándo autorizó el paciente el manejo de sus datos de salud.
  consentimientoEl           DateTime?
  responsableId              String?
  responsable                Usuario?       @relation("ContactoResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  creadoEl                   DateTime       @default(now())
  actualizadoEl              DateTime       @updatedAt

  oportunidades     Oportunidad[]
  actividades       Actividad[]
  notasRel          Nota[]
  cotizaciones      Cotizacion[]
  ventas            Venta[]
  citas             Cita[]
  notasClinicas     NotaClinica[]
  accesosExpediente AccesoExpediente[]

  @@index([empresaId])
  @@index([empresaId, nombre])
  @@index([empresaId, whatsapp])
}

model EtapaEmbudo {
  id           String  @id @default(cuid())
  empresaId    String
  empresa      Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre       String
  orden        Int
  probabilidad Int     @default(0)
  color        String  @default("#2563eb")
  esGanada     Boolean @default(false)
  esPerdida    Boolean @default(false)

  oportunidades Oportunidad[]

  @@unique([empresaId, nombre])
  @@index([empresaId, orden])
}

enum EstadoOportunidad {
  ABIERTA
  GANADA
  PERDIDA
}

model Oportunidad {
  id            String            @id @default(cuid())
  empresaId     String
  empresa       Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  titulo        String
  contactoId    String
  contacto      Contacto          @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  etapaId       String
  etapa         EtapaEmbudo       @relation(fields: [etapaId], references: [id])
  monto         Decimal           @default(0) @db.Decimal(12, 2)
  estado        EstadoOportunidad @default(ABIERTA)
  motivoPerdida String?
  fechaCierre   DateTime?
  responsableId String?
  responsable   Usuario?          @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  creadoEl      DateTime          @default(now())
  actualizadoEl DateTime          @updatedAt
  cerradaEl     DateTime?

  actividades  Actividad[]
  notasRel     Nota[]
  cotizaciones Cotizacion[]

  @@index([empresaId])
  @@index([empresaId, etapaId])
}

enum TipoActividad {
  LLAMADA
  WHATSAPP
  CORREO
  REUNION
  VISITA
  TAREA
}

model Actividad {
  id            String        @id @default(cuid())
  empresaId     String
  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo          TipoActividad @default(TAREA)
  titulo        String
  detalle       String?
  venceEl       DateTime?
  completada    Boolean       @default(false)
  completadaEl  DateTime?
  contactoId    String?
  contacto      Contacto?     @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  oportunidadId String?
  oportunidad   Oportunidad?  @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  creadoEl      DateTime      @default(now())

  @@index([empresaId, completada, venceEl])
  @@index([contactoId])
  @@index([oportunidadId])
}

model Nota {
  id            String       @id @default(cuid())
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contenido     String
  contactoId    String?
  contacto      Contacto?    @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario      @relation(fields: [usuarioId], references: [id])
  creadoEl      DateTime     @default(now())

  @@index([empresaId])
  @@index([contactoId])
  @@index([oportunidadId])
}

// ---------------------------------------------------------------------------
// Inventario
// ---------------------------------------------------------------------------

model Producto {
  id                 String   @id @default(cuid())
  empresaId          String
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre             String
  sku                String?
  descripcion        String?
  precio             Decimal  @default(0) @db.Decimal(12, 2)
  costo              Decimal  @default(0) @db.Decimal(12, 2)
  unidad             String   @default("unidad")
  // Los servicios no descuentan existencias.
  controlaInventario Boolean  @default(true)
  stock              Int      @default(0)
  stockMinimo        Int      @default(0)
  activo             Boolean  @default(true)
  creadoEl           DateTime @default(now())
  actualizadoEl      DateTime @updatedAt

  movimientos     MovimientoInventario[]
  itemsCotizacion CotizacionItem[]
  itemsVenta      VentaItem[]

  @@unique([empresaId, sku])
  @@index([empresaId])
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

model MovimientoInventario {
  id         String         @id @default(cuid())
  empresaId  String
  empresa    Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto       @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo       TipoMovimiento
  cantidad   Int
  stockFinal Int
  motivo     String?
  referencia String?
  usuarioId  String?
  usuario    Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  creadoEl   DateTime       @default(now())

  @@index([empresaId])
  @@index([productoId])
}

// ---------------------------------------------------------------------------
// Cotizaciones y ventas
// ---------------------------------------------------------------------------

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

model Cotizacion {
  id            String           @id @default(cuid())
  empresaId     String
  empresa       Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero        Int
  contactoId    String
  contacto      Contacto         @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  oportunidadId String?
  oportunidad   Oportunidad?     @relation(fields: [oportunidadId], references: [id], onDelete: SetNull)
  estado        EstadoCotizacion @default(BORRADOR)
  fecha         DateTime         @default(now())
  validaHasta   DateTime?
  // Copia del porcentaje vigente al emitir, para que el historico no cambie.
  ivaPorcentaje Decimal          @default(12) @db.Decimal(5, 2)
  subtotal      Decimal          @default(0) @db.Decimal(12, 2)
  descuento     Decimal          @default(0) @db.Decimal(12, 2)
  iva           Decimal          @default(0) @db.Decimal(12, 2)
  total         Decimal          @default(0) @db.Decimal(12, 2)
  notas         String?
  condiciones   String?
  enviadaEl     DateTime?
  // Token del enlace publico que se le manda al cliente por WhatsApp. Solo
  // existe si el usuario decidio compartirla; se puede revocar poniendolo a null.
  tokenPublico  String?          @unique
  vistaEl       DateTime?
  aceptadaEl    DateTime?
  // Nombre que escribio el cliente al aceptar desde el enlace publico.
  aceptadaPor   String?
  creadaPorId   String?
  creadaPor     Usuario?         @relation(fields: [creadaPorId], references: [id], onDelete: SetNull)
  creadoEl      DateTime         @default(now())
  actualizadoEl DateTime         @updatedAt

  items  CotizacionItem[]
  ventas Venta[]

  @@unique([empresaId, numero])
  @@index([empresaId])
}

model CotizacionItem {
  id             String     @id @default(cuid())
  cotizacionId   String
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  productoId     String?
  producto       Producto?  @relation(fields: [productoId], references: [id], onDelete: SetNull)
  descripcion    String
  cantidad       Decimal    @default(1) @db.Decimal(12, 2)
  precioUnitario Decimal    @default(0) @db.Decimal(12, 2)
  total          Decimal    @default(0) @db.Decimal(12, 2)
  orden          Int        @default(0)

  @@index([cotizacionId])
}

enum EstadoVenta {
  PENDIENTE
  PAGADA
  ANULADA
}

model Venta {
  id            String      @id @default(cuid())
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero        Int
  contactoId    String
  contacto      Contacto    @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  cotizacionId  String?
  cotizacion    Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: SetNull)
  estado        EstadoVenta @default(PENDIENTE)
  fecha         DateTime    @default(now())
  metodoPago    String      @default("Efectivo")
  // Datos que pide la factura guatemalteca; "CF" = consumidor final.
  nitCliente    String?     @default("CF")
  nombreFactura String?
  ivaPorcentaje Decimal     @default(12) @db.Decimal(5, 2)
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  descuento     Decimal     @default(0) @db.Decimal(12, 2)
  iva           Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @default(0) @db.Decimal(12, 2)
  notas         String?
  creadaPorId   String?
  creadaPor     Usuario?    @relation(fields: [creadaPorId], references: [id], onDelete: SetNull)
  creadoEl      DateTime    @default(now())

  items VentaItem[]
  cita  Cita?

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, fecha])
}

model VentaItem {
  id             String    @id @default(cuid())
  ventaId        String
  venta          Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     String?
  producto       Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  descripcion    String
  cantidad       Decimal   @default(1) @db.Decimal(12, 2)
  precioUnitario Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @default(0) @db.Decimal(12, 2)
  orden          Int       @default(0)

  @@index([ventaId])
}

// ---------------------------------------------------------------------------
// Agenda de citas (clinicas y consultorios)
// ---------------------------------------------------------------------------

/**
 * Medico, odontologo, terapeuta... quien atiende la cita. No tiene que ser un
 * usuario del sistema: muchos doctores no entran al CRM y la recepcion agenda
 * por ellos.
 */
model Profesional {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre       String
  especialidad String?
  color        String   @default("#3366f5")
  // Duracion por defecto de sus consultas, en minutos.
  duracionMin  Int      @default(30)
  // Calendario de Google donde caen sus citas. Si esta vacio se usa el de la
  // integracion de la empresa.
  calendarioId String?
  activo       Boolean  @default(true)
  creadoEl     DateTime @default(now())

  citas         Cita[]
  horarios      HorarioProfesional[]
  bloqueos      BloqueoAgenda[]
  usuario       Usuario?
  notasClinicas NotaClinica[]

  @@index([empresaId])
}

/**
 * Tramo de atención semanal: un médico puede tener varios por día (mañana y tarde).
 */
model HorarioProfesional {
  id            String      @id @default(cuid())
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  // 0 = domingo … 6 = sábado, como Date.getDay().
  diaSemana     Int
  // "08:00" y "12:30", hora de Guatemala.
  desde         String
  hasta         String

  @@index([profesionalId])
}

/**
 * Vacaciones, almuerzo, congreso… Sin profesional, bloquea a toda la clínica.
 */
model BloqueoAgenda {
  id            String       @id @default(cuid())
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  profesionalId String?
  profesional   Profesional? @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  inicio        DateTime
  fin           DateTime
  motivo        String
  creadoEl      DateTime     @default(now())

  @@index([empresaId, inicio])
}

/**
 * Servicio que ofrece la clínica: duración, precio y si se reserva en línea.
 */
model TipoConsulta {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre         String
  duracionMin    Int      @default(30)
  precio         Decimal  @default(0) @db.Decimal(12, 2)
  reservable     Boolean  @default(true)
  // Quiénes lo atienden; vacío = cualquier profesional.
  profesionalIds String[] @default([])
  activo         Boolean  @default(true)
  creadoEl       DateTime @default(now())

  citas Cita[]

  @@index([empresaId])
}

enum OrigenCita {
  RECEPCION
  EN_LINEA
}

enum EstadoCita {
  PROGRAMADA
  CONFIRMADA
  COMPLETADA
  NO_ASISTIO
  CANCELADA
}

model Cita {
  id                 String        @id @default(cuid())
  empresaId          String
  empresa            Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contactoId         String
  contacto           Contacto      @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  profesionalId      String?
  profesional        Profesional?  @relation(fields: [profesionalId], references: [id], onDelete: SetNull)
  inicio             DateTime
  fin                DateTime
  motivo             String
  notas              String?
  estado             EstadoCita    @default(PROGRAMADA)
  // Enlace que recibe el paciente para ver, confirmar o cancelar su cita.
  tokenPublico       String        @unique
  confirmadaEl       DateTime?
  // Quien confirmo: "paciente (enlace)", "paciente (WhatsApp)" o el usuario.
  confirmadaPor      String?
  canceladaEl        DateTime?
  motivoCancelacion  String?
  // Si es true y el paciente tiene correo, Google le manda la invitacion y la
  // cita aparece sola en su calendario.
  invitarPaciente    Boolean       @default(true)
  tipoConsultaId     String?
  tipoConsulta       TipoConsulta? @relation(fields: [tipoConsultaId], references: [id], onDelete: SetNull)
  origen             OrigenCita    @default(RECEPCION)
  // Cobro de la consulta: se registra como venta para que salga en reportes.
  ventaId            String?       @unique
  venta              Venta?        @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  // Lo que el paciente contesta en su enlace después de la consulta.
  calificacion       Int?
  comentarioPaciente String?

  // Sincronizacion con Google Calendar de la clinica.
  googleEventoId       String?
  googleCalendarioId   String?
  googleSincronizadaEl DateTime?
  googleError          String?

  creadaPorId   String?
  creadaPor     Usuario? @relation(fields: [creadaPorId], references: [id], onDelete: SetNull)
  creadoEl      DateTime @default(now())
  actualizadoEl DateTime @updatedAt

  recordatorios Recordatorio[]
  notasClinicas NotaClinica[]

  @@index([empresaId, inicio])
  @@index([contactoId])
  @@index([profesionalId, inicio])
}

enum TipoRecordatorio {
  CONFIRMACION
  PRIMERO
  SEGUNDO
  // Después de atendida: "le toca su control".
  SEGUIMIENTO
}

enum EstadoRecordatorio {
  PENDIENTE
  ENVIANDO
  ENVIADO
  ENTREGADO
  LEIDO
  FALLIDO
  CANCELADO
}

/**
 * Mensaje de WhatsApp programado para una cita. Se crean al agendar y el cron
 * de /api/cron/recordatorios los envia cuando llega su hora.
 */
model Recordatorio {
  id             String             @id @default(cuid())
  empresaId      String
  empresa        Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  citaId         String
  cita           Cita               @relation(fields: [citaId], references: [id], onDelete: Cascade)
  tipo           TipoRecordatorio
  programadoPara DateTime
  estado         EstadoRecordatorio @default(PENDIENTE)
  intentos       Int                @default(0)
  enviadoEl      DateTime?
  // wamid que devuelve la API de WhatsApp; con el se emparejan los avisos de
  // entregado y leido que llegan al webhook.
  mensajeId      String?            @unique
  error          String?
  creadoEl       DateTime           @default(now())
  actualizadoEl  DateTime           @updatedAt

  @@unique([citaId, tipo])
  @@index([estado, programadoPara])
  @@index([empresaId])
}

/**
 * Cuenta de Google conectada por la empresa. El refresh token va cifrado.
 */
model IntegracionGoogle {
  id                  String    @id @default(cuid())
  empresaId           String    @unique
  empresa             Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  email               String
  refreshTokenCifrado String
  accessTokenCifrado  String?
  accessTokenExpira   DateTime?
  calendarioId        String    @default("primary")
  calendarioNombre    String?
  conectadaEl         DateTime  @default(now())
  // Se llena si Google revoco el acceso; la interfaz pide reconectar.
  error               String?
}

/**
 * Numero de WhatsApp Business (API oficial de Meta) de la empresa. Los mensajes
 * que inicia el negocio fuera de la ventana de 24 horas tienen que salir con
 * una plantilla aprobada por Meta.
 */
model IntegracionWhatsApp {
  id                    String   @id @default(cuid())
  empresaId             String   @unique
  empresa               Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  phoneNumberId         String   @unique
  accessTokenCifrado    String
  // Lo que Meta reporta del número al verificar el token, para mostrarlo.
  numeroVisible         String?
  nombreVerificado      String?
  plantillaRecordatorio String   @default("recordatorio_cita")
  plantillaConfirmacion String?
  plantillaSeguimiento  String?
  idiomaPlantilla       String   @default("es")
  activa                Boolean  @default(true)
  enviarConfirmacion    Boolean  @default(true)
  // Horas antes de la cita para cada recordatorio; 0 apaga el segundo.
  horasPrimero          Int      @default(24)
  horasSegundo          Int      @default(2)
  actualizadoEl         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Expediente clínico
// ---------------------------------------------------------------------------

/**
 * Nota de una consulta: lo que vio el médico y lo que indicó.
 */
model NotaClinica {
  id            String       @id @default(cuid())
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contactoId    String
  contacto      Contacto     @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  citaId        String?
  cita          Cita?        @relation(fields: [citaId], references: [id], onDelete: SetNull)
  profesionalId String?
  profesional   Profesional? @relation(fields: [profesionalId], references: [id], onDelete: SetNull)
  usuarioId     String
  usuario       Usuario      @relation(fields: [usuarioId], references: [id])
  motivo        String?
  // Signos vitales como texto: cada clínica los anota a su manera ("120/80").
  presion       String?
  pesoKg        String?
  tallaCm       String?
  temperatura   String?
  diagnostico   String?
  tratamiento   String?
  receta        String?
  creadoEl      DateTime     @default(now())

  @@index([empresaId, contactoId])
}

/**
 * Bitácora de quién abrió o escribió el expediente de cada paciente.
 */
model AccesoExpediente {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  accion     String
  creadoEl   DateTime @default(now())

  @@index([empresaId, contactoId, creadoEl])
}
