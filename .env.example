# Conexion a PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/crm_chapin?schema=public"

# Llave para firmar la sesion. Generala con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-una-llave-larga-y-aleatoria"

# URL publica de la app (se usa en enlaces de cotizaciones y WhatsApp)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Correo saliente (recuperación de contraseña). Si lo dejás vacío, el enlace
# se escribe en el log del servidor en vez de enviarse.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USUARIO=""
SMTP_PASSWORD=""
SMTP_REMITENTE="CRM Chapín <no-responder@tudominio.com>"

# --- Agenda de citas ---------------------------------------------------------
# NEXT_PUBLIC_APP_URL (arriba) es obligatoria para la agenda: con ella se arman
# los enlaces que recibe el paciente por WhatsApp y la URL de retorno de Google.
# Se incrusta al compilar, así que definila antes de `npm run build`.

# Google Calendar (OAuth). En Google Cloud Console: APIs y servicios → habilitá
# "Google Calendar API" → Credenciales → ID de cliente OAuth (aplicación web)
# con la URL de retorno: <NEXT_PUBLIC_APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# WhatsApp Cloud API (Meta). El número y el token los carga cada clínica desde
# Configuración → Google y WhatsApp; aquí van los datos de la app de Meta que
# recibe el webhook en <NEXT_PUBLIC_APP_URL>/api/whatsapp/webhook
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_API_VERSION="v23.0"

# Protege /api/cron/recordatorios. Generala con: openssl rand -base64 32
CRON_SECRET=""

# Opcional: llave para cifrar los tokens de Google y WhatsApp en la base. Si no
# se define se deriva de AUTH_SECRET. Cambiarla obliga a reconectar ambos.
# CIFRADO_SECRETO=""
